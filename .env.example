# Land in Coorg — environment contract (continue.md §28).
# Names and safe comments only. Copy to `.env.local` for local development and
# set the same names in Vercel per environment (Preview = staging, Production).
# Never prefix a secret with NEXT_PUBLIC_. Never commit a filled-in copy.

# --- Application -------------------------------------------------------------
# local | staging | production. Test-only shortcuts refuse to run in production.
APP_ENV=local
# Canonical origin, no trailing slash. Used for safe redirects and CORS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (database + Auth) ----------------------------------------------
# Project Settings -> API. The publishable key is public by design; RLS and
# the database functions are what protect data.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS: used only after the server has authorized the
# actor (uploads finalization, rate limiting, webhooks, admin reads).
SUPABASE_SECRET_KEY=


# Supabase Auth "Send SMS" HTTP hook secret, shown when the hook is created
# (Authentication -> Hooks). Format: v1,whsec_<base64>.
SEND_SMS_HOOK_SECRET=

# --- MSG91 (OTP delivery for Supabase-issued codes) ---------------------------
MSG91_AUTH_KEY=
# Flow/template id of the DLT-approved OTP template.
MSG91_OTP_TEMPLATE_ID=
# Template variable that receives the code (e.g. ##otp## -> otp).
MSG91_OTP_VARIABLE=otp
# MSG91 OTP widget (real numbers). All three of widget id, token auth and
# MSG91_AUTH_KEY must be set; otherwise every number uses Supabase OTP.
# Widget ID for MSG91 OTP widget
NEXT_PUBLIC_MSG91_WIDGET_ID=
# Token Auth for MSG91 OTP widget
NEXT_PUBLIC_MSG91_TOKEN_AUTH=
# Staging only: comma-separated E.164 numbers allowed to receive SMS (SMS-006).
# Leave empty in production. Non-allowlisted numbers are refused, not sent.
SMS_TEST_ALLOWLIST=

# --- Tigris private object storage (S3-compatible) ----------------------------
# Server-only credentials scoped to the three buckets below.
TIGRIS_STORAGE_ACCESS_KEY_ID=
TIGRIS_STORAGE_SECRET_ACCESS_KEY=
# Endpoint from the Tigris console for your account.
TIGRIS_STORAGE_ENDPOINT=https://t3.storage.dev
TIGRIS_STORAGE_REGION=auto
# Separate private buckets per environment, e.g. coorg-staging-media.
TIGRIS_BUCKET_MEDIA=
TIGRIS_BUCKET_DOCUMENTS=
TIGRIS_BUCKET_AVATARS=

# --- Brevo (transactional email; later phase) ---------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Land in Coorg

# --- Operations (later phases) ------------------------------------------------
# Shared secret for scheduled job endpoints (expiry, cleanup, delivery recovery).
# REQUIRED on Vercel for listing videos: each transcode job is started by the
# app calling /api/jobs/video with this secret. Without it videos stay
# "processing". Locally (next dev / next start) jobs run in-process instead.
CRON_SECRET=
# Optional. Use a system ffmpeg/ffprobe instead of the bundled static builds.
FFMPEG_PATH=
FFPROBE_PATH=
SENTRY_DSN=
MAPS_API_KEY=
# Staging only: comma-separated E.164 numbers with fixed Supabase test codes
# ([auth.sms.test_otp]); they skip the widget. Leave empty in production.
AUTH_TEST_OTP_PHONES=

# Land in Coorg phone for buyers (Call / WhatsApp buttons on listings), E.164, e.g. +919876543210
NEXT_PUBLIC_CONTACT_PHONE=
